[ext_resource type="Script" path="res://scripts/spell.gd" id="1_leech"]

[resource]
script = ExtResource("1_leech")
spell_name = "Leech"
school = "Blood"
gesture = "tsunami"
targeting = "directional"
cost = 24.0
effect = "Tether yourself to someone's strength. For up to 24 seconds they pay half the stamina of every spell you cast. It breaks if you lose sight of each other, drift too far apart or either of you falls."
