[gd_resource type="Resource" script_class="Spell" format=3]

[ext_resource type="Script" path="res://scripts/spell.gd" id="1_sphere"]

[resource]
script = ExtResource("1_sphere")
spell_name = "Flaming Sphere"
school = "Fire"
gesture = "sphere"
targeting = "directional"
cost = 30.0
effect = "Launch a ball of fire that rolls along the ground, follows slopes, climbs walls and falls into pits. It burns out after a long roll, and water puts it out."
damage = "6 damage to whatever it touches, again every 0.8 seconds"
