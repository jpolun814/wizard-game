parts = Array[Dictionary]([{"where": "self", "for": 2.5, "does": [{"do": "drive", "way": "level", "speed": 470.0}]}, {"where": "with", "ahead": 80.0, "for": 2.5, "does": [{"do": "throw", "way": "level", "speed": 620.0, "up": 260.0, "every": 0.8}]}])
